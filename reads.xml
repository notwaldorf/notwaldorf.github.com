---
layout: nil
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">

 <title>Monica Dinculescu's recent reads</title>
 <link href="{{ site.url }}/reads.xml" rel="self"/>
 <link href="{{ site.url }}/reads/"/>
 <updated>{{ site.time | date_to_xmlschema }}</updated>
 <id>{{ site.url }}/reads.xml</id>
 <author>
   <name>{{ site.name }}</name>
 </author>

 {% for book in site.data.books limit:50 %}
 <entry>
   <title>{{ book.title | xml_escape }}{% if book.author %} — {{ book.author | xml_escape }}{% endif %}</title>
   <link href="https://www.goodreads.com/book/show/{{ book.gr_id }}"/>
   {% if book.read and book.read != "" %}<updated>{{ book.read | date_to_xmlschema }}</updated>{% else %}<updated>{{ site.time | date_to_xmlschema }}</updated>{% endif %}
   <id>https://www.goodreads.com/book/show/{{ book.gr_id }}</id>
   <content type="html">{% capture entry %}{% if book.image %}&lt;p&gt;&lt;img src="{{ book.image }}" alt="{{ book.title | xml_escape }} cover"&gt;&lt;/p&gt;{% endif %}&lt;p&gt;&lt;strong&gt;{{ book.title | xml_escape }}&lt;/strong&gt;{% if book.author %} by {{ book.author | xml_escape }}{% endif %}&lt;br&gt;Rating: {% if book.rating and book.rating != 0 %}{{ book.rating }}/5{% else %}n/a{% endif %}{% if book.read and book.read != "" %} · Finished {{ book.read }}{% endif %}&lt;/p&gt;{% if book.review and book.review != "" and book.review != "None" %}&lt;p&gt;{{ book.review | xml_escape }}&lt;/p&gt;{% endif %}{% endcapture %}{{ entry }}</content>
 </entry>
 {% endfor %}

</feed>
